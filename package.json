{
  "name": "babustv",
  "version": "1.10.1",
  "description": "BabuşTV — Samsung Tizen TV player",
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w player",
    "build": "npm run build -w player",
    "test": "node --test player/test/*.test.js && npm run test:ts -w player",
    "typecheck": "npm run typecheck -w player",
    "brand:check": "node tools/check-legacy-brand.mjs",
    "tizen": "cd tizen && node package.mjs",
    "tizen:build": "node tizen/stage.mjs",
    "tizen:package": "node tizen/wgt.mjs",
    "tizen:emu": "npm run tizen:build && npm run tizen:package && node tizen/deploy.mjs",
    "tizen:log": "node tizen/dlog.mjs",
    "rc:browser": "playwright test -c tools/rc-browser/playwright.config.mjs",
    "rc:browser:list": "playwright test -c tools/rc-browser/playwright.config.mjs --list"
  },
  "workspaces": [
    "player",
    "tizen"
  ],
  "keywords": [
    "tizen",
    "iptv",
    "samsung",
    "tv",
    "player"
  ],
  "author": "BabuşTV",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
