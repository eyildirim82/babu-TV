{
  "name": "@babustv/relay-cloudflare",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "description": "BabuşTV pairing relay on Cloudflare Workers with a Durable Object",
  "license": "MIT",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "test": "node scripts/check-sources.mjs && node scripts/prepare-assets.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/prepare-assets.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/prepare-assets.mjs && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.9",
    "@cloudflare/workers-types": "5.20260914.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  }
}
