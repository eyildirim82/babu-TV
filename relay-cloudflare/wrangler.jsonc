{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babustv-pairing-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // Privacy: no stored request logs or traces (docs/decisions/0003-pairing-relay-hosting.md).
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false }
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayShard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayShard"] }],
  // The phone pairing page is the player build under /babustv/; relay paths always reach the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/pairing/*"]
  }
}
